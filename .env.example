# Copy this file to .env and adjust as needed. docker-compose reads this automatically.
# .env itself is gitignored on purpose - never commit real secrets.

# Postgres container settings (used to create the database on first run).
POSTGRES_USER=incidentflow
POSTGRES_PASSWORD=incidentflow
POSTGRES_DB=incidentflow
POSTGRES_PORT=5432

REDIS_PORT=6379

# Full connection strings the backend actually uses. Note the hostnames
# "postgres"/"redis" - those only resolve inside the Docker Compose network
# (see docker-compose.yml), not from your host machine.
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=incidentflow;Username=incidentflow;Password=incidentflow
REDIS_CONNECTION_STRING=redis:6379

# Used to sign/verify login JWTs (see backend/IncidentFlow.Api/Security/JwtService.cs).
# Change this to a long random string for anything beyond local development.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Host ports exposed for each service. Change BACKEND_PORT/FRONTEND_PORT here
# if something else on your machine is already using 8001/5173.
BACKEND_PORT=8001
FRONTEND_PORT=5173

# Which frontend origin the backend allows to call it (CORS).
CORS_ORIGINS=http://localhost:5173

# Baked into the frontend build - the URLs it uses to reach the backend from
# your browser (not from inside Docker's network, so "localhost" here, unlike DATABASE_URL above).
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001

# Seed the database with the demo company on startup: 14 departments and 75
# employees (see backend/IncidentFlow.Api/Data/SeedData.cs). Every demo
# account shares the password "incidentflow123", so switch this off for any
# database you care about. Departments are always seeded regardless - the
# app needs them, since every employee must belong to one.
SEED_DEMO_EMPLOYEES=true
