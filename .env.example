# Copy this file to .env and adjust as needed. docker-compose reads this automatically.

POSTGRES_USER=incidentflow
POSTGRES_PASSWORD=incidentflow
POSTGRES_DB=incidentflow
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://incidentflow:incidentflow@postgres:5432/incidentflow
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
FRONTEND_PORT=5173

CORS_ORIGINS=http://localhost:5173

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
